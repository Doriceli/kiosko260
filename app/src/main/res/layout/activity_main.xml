<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <!-- Encabezado: hashtag y contador del día -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:shadowColor="@color/morado"
            android:shadowDy="4"
            android:shadowRadius="1"
            android:textColor="@color/blanco"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/blanco"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Evento actual: nombre (va en el nombre del archivo) + contador del evento con reinicio manual -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/event_label"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eventCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/resetEventButton"
            style="@style/KioskButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/event_reset"
            android:textSize="14sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/eventNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_interactive"
        android:drawableEnd="@android:drawable/ic_menu_edit"
        android:hint="@string/event_hint"
        android:importantForAutofill="no"
        android:inputType="textCapWords"
        android:maxLength="40"
        android:minHeight="52dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/morado"
        android:textColorHint="@color/rosa_viejo"
        android:textStyle="bold" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        app:tabIndicatorColor="@color/azul_electrico"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="4dp"
        app:tabSelectedTextColor="@color/blanco"
        app:tabTextColor="@color/blanco_suave" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Pestaña "En vivo" -->
        <ScrollView
            android:id="@+id/livePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/blanco"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Barra de edición: gruesa, redondeada y en azul eléctrico -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:visibility="gone"
                    app:indicatorColor="@color/azul_electrico"
                    app:trackColor="#55FFFFFF"
                    app:trackCornerRadius="12dp"
                    app:trackThickness="22dp" />

                <TextView
                    android:id="@+id/progressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/blanco"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/notificationAccessButton"
                    style="@style/KioskButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/notification_access"
                    android:visibility="gone" />

                <!-- Modo de red: recibir por Quick Share / compartir QR -->
                <TextView
                    android:id="@+id/modeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textColor="@color/blanco"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- QR para conectarse a la red Wi-Fi del kiosko (sin internet) -->
                <LinearLayout
                    android:id="@+id/wifiRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/wifiQr"
                        android:layout_width="115dp"
                        android:layout_height="115dp"
                        android:background="@drawable/bg_qr"
                        android:contentDescription="@string/wifi_qr_description"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <!-- Datos de la red, grandes, para quien no puede escanear el QR -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_info_strong"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/wifiTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/blanco"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/wifiSsid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/blanco"
                            android:textIsSelectable="true"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/wifiPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/azul_electrico"
                            android:textIsSelectable="true"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/wifiText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/blanco_suave"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/connectWifiButton"
                    style="@style/KioskButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/hotspotButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        style="@style/KioskButton"
                        android:id="@+id/receiveButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/receive_button" />

                    <Button
                        style="@style/KioskButton"
                        android:id="@+id/shareButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/share_button" />
                </LinearLayout>

                <!-- Vista previa del video a un lado del QR -->
                <LinearLayout
                    android:id="@+id/resultRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/preview"
                            android:layout_width="match_parent"
                            android:layout_height="300dp"
                            android:contentDescription="@string/preview_description"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/previewLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/blanco"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <!-- QR de descarga: más grande y llamativo que el de Wi-Fi -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_info_strong"
                            android:paddingStart="14dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="6dp"
                            android:text="@string/scan_me"
                            android:textColor="@color/blanco"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/qr"
                            android:layout_width="235dp"
                            android:layout_height="235dp"
                            android:background="@drawable/bg_qr_download"
                            android:contentDescription="@string/qr_description"
                            android:elevation="8dp"
                            android:padding="12dp"
                            android:scaleType="fitCenter" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Dirección corta para quien no puede escanear el QR -->
                <LinearLayout
                    android:id="@+id/urlBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_info_strong"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/url_label"
                        android:textColor="@color/blanco"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/url"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/azul_electrico"
                        android:textIsSelectable="true"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Opción extra: compartir el video con Quick Share (QR / enlace de Samsung) -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/quickShareSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/quick_share_switch"
                    android:textColor="@color/blanco"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/quickShareBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/quickShareButton"
                        style="@style/KioskButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/quick_share_button" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_card"
                        android:padding="10dp"
                        android:text="@string/quick_share_hint"
                        android:textColor="@color/blanco"
                        android:textSize="14sp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/authorizeCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_interactive"
                    android:buttonTint="@color/morado"
                    android:elevation="6dp"
                    android:minHeight="60dp"
                    android:padding="10dp"
                    android:text="@string/authorize"
                    android:textColor="@color/morado"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />



                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/autoSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:checked="true"
                    android:text="@string/auto_process"
                    android:textColor="@color/blanco"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/hashtag_label"
                    android:textColor="@color/blanco"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/hashtagInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_interactive"
                    android:drawableEnd="@android:drawable/ic_menu_edit"
                    android:hint="@string/hashtag_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="40"
                    android:minHeight="48dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/morado"
                    android:textColorHint="@color/rosa_viejo"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/network_mode_label"
                    android:textColor="@color/blanco"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/networkModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_interactive"
                    android:elevation="6dp"
                    android:padding="6dp">

                    <RadioButton
                        android:id="@+id/radioEventWifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/morado"
                        android:minHeight="52dp"
                        android:textColor="@color/morado"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/radioHotspot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/morado"
                        android:minHeight="52dp"
                        android:text="@string/network_mode_hotspot"
                        android:textColor="@color/morado"
                        android:textStyle="bold" />
                </RadioGroup>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/doubleLogoSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/double_logo"
                    android:textColor="@color/blanco"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/doubleLogoWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/double_logo_missing"
                    android:textColor="@color/blanco"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/speed_label"
                    android:textColor="@color/blanco"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/speedSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_interactive"
                    android:elevation="6dp"
                    android:minHeight="56dp"
                    android:paddingStart="8dp"
                    android:popupBackground="@color/blanco" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/music_label"
                    android:textColor="@color/blanco"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/musicSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_interactive"
                    android:elevation="6dp"
                    android:minHeight="56dp"
                    android:paddingStart="8dp"
                    android:popupBackground="@color/blanco" />

                <TextView
                    android:id="@+id/musicWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/music_missing"
                    android:textColor="@color/blanco"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/pickButton"
                    style="@style/KioskButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/pick_video" />

                <TextView
                    android:id="@+id/networkInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/blanco_suave"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/folderInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/blanco_suave"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Pestaña "Procesados" -->
        <LinearLayout
            android:id="@+id/historyPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/historyCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="@color/blanco"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/historyEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/history_empty"
                android:textColor="@color/blanco"
                android:textSize="16sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
